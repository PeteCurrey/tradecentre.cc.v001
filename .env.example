# ============================================================================
# Trading Desk — environment
#
# Copy to .env.local for development. Nothing in this file may ever be
# prefixed NEXT_PUBLIC_ — every value here is a server-side secret.
# ============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/desk

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# node scripts/hash-password.mjs "your password"
AUTH_PASSWORD_HASH=

# --- OANDA ------------------------------------------------------------------
# ⚠️ These are FULL TRADING CREDENTIALS. The v20 API has no read-only scope.
# Live and practice are separate systems requiring separate tokens.
# Generate at: OANDA account → Manage API Access
#
# This app calls read endpoints only and never places or modifies orders.
OANDA_LIVE_TOKEN=
OANDA_PRACTICE_TOKEN=

# --- Market context (all optional — the app degrades rather than breaks) -----
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=
POLYGON_API_KEY=

# --- AI providers (on demand only — none required to run the app) -----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
